APP_ENV=development

POSTGRES_DB=talkflow
POSTGRES_USER=talkflow
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+asyncpg://talkflow:change_me@postgres:5432/talkflow

REDIS_URL=redis://redis:6379/0

AI_GATEWAY_HOST=0.0.0.0
AI_GATEWAY_PORT=8000

LOG_LEVEL=INFO
AUDIOSOCKET_HOST=0.0.0.0
AUDIOSOCKET_PORT=9019

# Phase 1 only.
# Echo incoming caller PCM back toward Asterisk.
# AUDIOSOCKET_ECHO_ENABLED=true

# ============================================================
# Phase 2 — Voice Activity Detection
# ============================================================

VAD_ENABLED=true

VAD_PROVIDER=silero
VAD_DEVICE=cpu
VAD_USE_ONNX=true

# Native AudioSocket audio.
VAD_SAMPLE_RATE=8000

# Silero requires 256 samples at 8 kHz = 32 ms.
VAD_CHUNK_SAMPLES=256

# Speech probability needed to enter speech candidate state.
VAD_THRESHOLD=0.50

# Hysteresis threshold for exiting speech.
VAD_NEG_THRESHOLD=0.35

# Require a short sustained speech period to avoid clicks/noise.
VAD_MIN_SPEECH_MS=96

# Initial endpoint configuration.
# 256 ms fits TalkFlow's desired 100–300 ms endpoint range.
VAD_MIN_SILENCE_MS=256

# Safety limit, not normal endpointing.
VAD_MAX_SPEECH_SECONDS=30

# Number of persistent/preloaded VAD model instances.
VAD_POOL_SIZE=4

# How long a new call can wait for a free VAD instance.
VAD_POOL_ACQUIRE_TIMEOUT_MS=250

# Do not log a probability every 32 ms in normal operation.
VAD_LOG_PROBABILITIES=false

# Phase 2 live testing:
AUDIOSOCKET_ECHO_ENABLED=false

# ============================================================
# Phase 3 — Streaming ASR
# ============================================================


ASR_PROVIDER=nemo

ASR_MODEL=models/parakeet-unified-en-0.6b/parakeet-unified-en-0.6b.nemo
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16

ASR_LANGUAGE=en

ASR_INPUT_SAMPLE_RATE=8000
ASR_SAMPLE_RATE=16000

ASR_PRE_ROLL_MS=1200

ASR_PARTIAL_ENABLED=true
ASR_PARTIAL_MIN_AUDIO_MS=640
ASR_PARTIAL_INTERVAL_MS=480

ASR_FINAL_BEAM_SIZE=1
ASR_PARTIAL_BEAM_SIZE=1

ASR_MAX_UTTERANCE_SECONDS=30

ASR_QUEUE_MAXSIZE=16

ASR_WORKERS=1

ASR_LOG_PARTIALS=true

ASR_WORD_TIMESTAMPS=false

ASR_CONDITION_ON_PREVIOUS_TEXT=false

# TalkFlow owns VAD.
ASR_INTERNAL_VAD=false

# ============================================================
# Phase 4 — Deterministic Qualification Engine
# ============================================================

QUALIFICATION_ENABLED=true

# Campaign qualification policy.
QUALIFICATION_MIN_AGE=65

# ZIP validation.
QUALIFICATION_ZIP_LENGTH=5

# Protect against pathological endless conversations.
QUALIFICATION_MAX_CLARIFICATIONS_PER_FIELD=3

# Logs structured state transitions without logging unnecessary PII.
QUALIFICATION_LOG_STATE_TRANSITIONS=true

# Do not log full collected personal fields in normal production logs.
QUALIFICATION_LOG_FIELD_VALUES=false

# ============================================================
# Phase 5 — Pre-generated TTS
# ============================================================


# No runtime synthesis in Phase 5.
TTS_MODE=pregenerated



# AudioSocket pacing.

# Cache.

# Use the existing Phase 0 Redis connection.
# Do not create another Redis server.
TTS_REDIS_DB=0

# Playback.

# Phase 5 does not interrupt currently playing prompts.

# Generator metadata.
TTS_PROVIDER=chatterbox
CHATTERBOX_MODEL=turbo
CHATTERBOX_DEVICE=cuda
CHATTERBOX_VOICE_REFERENCE=assets/voices/talkflow/talkflow_reference.wav

# Legacy Kokoro config (kept for fallback)
TTS_VOICE=af_heart
TTS_SPEED=1.0
TTS_LANGUAGE=en-us

TTS_LOG_TEXT=false
# ============================================================
# Phase 6 — Model Provider Abstraction
# ============================================================

# ----------------------------
# STT provider
# ----------------------------

STT_PROVIDER_CLASS=app.realtime.providers.stt_faster_whisper:FasterWhisperSTTProvider

STT_MODEL=large-v3-turbo
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_LANGUAGE=en

# Existing Phase 3 settings remain valid.
ASR_ENABLED=true

# ----------------------------
# TTS routing
# ----------------------------

TTS_ENABLED=true

# Fixed Phase 5 prompts.
TTS_PREGENERATED_PROVIDER_CLASS=app.realtime.providers.tts_pregenerated:PregeneratedTTSProvider

# Dynamic Phase 6 prompts.
TTS_DYNAMIC_PROVIDER_CLASS=app.realtime.providers.tts_chatterbox_http:ChatterboxHttpTTSProvider

TTS_DEFAULT_VOICE_ID=talkflow_primary

# Local isolated TTS worker.
TTS_WORKER_URL=http://127.0.0.1:8091
TTS_WORKER_TIMEOUT_SECONDS=60

# Telephony output contract.
TTS_SAMPLE_RATE=8000
TTS_CHANNELS=1
TTS_SAMPLE_WIDTH_BYTES=2
TTS_FRAME_MS=20

# Preserve Phase 5 cache.
TTS_ASSET_VERSION=talkflow-chatterbox-v1
TTS_ASSET_DIR=assets/tts/talkflow-chatterbox-v1
TTS_CACHE_PREFIX=talkflow:tts
TTS_CACHE_ENABLED=true
TTS_CACHE_LOCAL_FALLBACK=true

# Runtime limits.
TTS_DYNAMIC_MAX_CHARS=500
TTS_PLAYBACK_QUEUE_SIZE=8



# ============================================================
# Phase 7 — Barge-in / interruption
# ============================================================

BARGE_IN_ENABLED=true

# Minimum caller speech before interrupting bot playback.
# Silero already handles debounce, so keep this low initially.
BARGE_IN_MIN_SPEECH_MS=96

# Cancel currently playing bot audio.
BARGE_IN_CANCEL_CURRENT_PLAYBACK=true

# Discard queued responses for the old bot turn.
BARGE_IN_FLUSH_PLAYBACK_QUEUE=true

# Reject audio chunks created before the interruption generation.
BARGE_IN_DROP_STALE_AUDIO=true

# Optional grace after playback starts before barge-in is accepted.
# Start with 0 for natural interruption.
BARGE_IN_GRACE_MS=0

# Development logs.
BARGE_IN_LOG_EVENTS=true

# Existing Phase 6 setting changes from false to true.
TTS_INTERRUPT_ENABLED=true

# ============================================================
# Phase 8 — LLM conversational fallback
# ============================================================

LLM_ENABLED=true

LLM_PROVIDER_CLASS=app.realtime.providers.llm_openai_compat:OpenAICompatibleLLMProvider

# vLLM OpenAI-compatible endpoint.
LLM_BASE_URL=http://127.0.0.1:8100/v1

# Local vLLM can use any non-empty placeholder unless auth is enabled.
LLM_API_KEY=EMPTY

# Exact official Qwen model used by TalkFlow.
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ

# Important: real-time calls use non-thinking mode.
LLM_ENABLE_THINKING=false

# Short responses are essential for voice latency.
LLM_MAX_TOKENS=80

LLM_TEMPERATURE=0.7
LLM_TOP_P=0.8
LLM_TOP_K=20

# Prevent excessive repetition.
LLM_PRESENCE_PENALTY=0.3

# Network/model timeout.
LLM_TIMEOUT_SECONDS=5.0

# Limit conversational history sent to Qwen.
LLM_MAX_HISTORY_TURNS=4

# Do not send huge caller transcripts to model.
LLM_MAX_INPUT_CHARS=2000

# Never invoke LLM for normal deterministic turns.
LLM_FALLBACK_ONLY=true

# Dummy provider test.
LLM_DUMMY_RESPONSE=I can help with that. Let's continue with the qualification questions.

# Internal debug endpoint only.
LLM_DEBUG_ENDPOINTS=true

# ============================================================
# Phase 9 — Streaming response orchestration
# ============================================================

RESPONSE_STREAMING_ENABLED=true

LLM_STREAMING_ENABLED=true

# First natural chunk should be short enough to reach TTS fast.
LLM_STREAM_MIN_CHARS=24

# Prefer sentence boundaries.
LLM_STREAM_TARGET_CHARS=90

# Never let one pending speech segment grow excessively.
LLM_STREAM_MAX_CHARS=180

# Permit punctuation-based clause flushes before a full sentence.
LLM_STREAM_ALLOW_CLAUSE_BOUNDARIES=true

# Avoid producing tiny "Yes," / "Well," TTS jobs.
LLM_STREAM_MIN_WORDS=4

# Maximum queued dynamic response segments per turn.
RESPONSE_STREAM_QUEUE_MAXSIZE=4

# Once caller interrupts, all remaining chunks are stale.
RESPONSE_DROP_STALE_GENERATIONS=true