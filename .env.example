APP_ENV=development

POSTGRES_DB=talkflow
POSTGRES_USER=talkflow
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+asyncpg://talkflow:change_me@postgres:5432/talkflow

REDIS_URL=redis://redis:6379/0

AI_GATEWAY_HOST=0.0.0.0
AI_GATEWAY_PORT=8000

LOG_LEVEL=INFO
AUDIOSOCKET_HOST=0.0.0.0
AUDIOSOCKET_PORT=9019

# Phase 1 only.
# Echo incoming caller PCM back toward Asterisk.
# AUDIOSOCKET_ECHO_ENABLED=true

# ============================================================
# Phase 2 — Voice Activity Detection
# ============================================================

VAD_ENABLED=true

VAD_PROVIDER=silero
VAD_DEVICE=cpu
VAD_USE_ONNX=true

# Native AudioSocket audio.
VAD_SAMPLE_RATE=8000

# Silero requires 256 samples at 8 kHz = 32 ms.
VAD_CHUNK_SAMPLES=256

# Speech probability needed to enter speech candidate state.
VAD_THRESHOLD=0.50

# Hysteresis threshold for exiting speech.
VAD_NEG_THRESHOLD=0.35

# Require a short sustained speech period to avoid clicks/noise.
VAD_MIN_SPEECH_MS=96

# Initial endpoint configuration.
# 256 ms fits TalkFlow's desired 100–300 ms endpoint range.
VAD_MIN_SILENCE_MS=256

# Safety limit, not normal endpointing.
VAD_MAX_SPEECH_SECONDS=30

# Number of persistent/preloaded VAD model instances.
VAD_POOL_SIZE=4

# How long a new call can wait for a free VAD instance.
VAD_POOL_ACQUIRE_TIMEOUT_MS=250

# Do not log a probability every 32 ms in normal operation.
VAD_LOG_PROBABILITIES=false

# Phase 2 live testing:
AUDIOSOCKET_ECHO_ENABLED=false

# ============================================================
# Phase 3 — Streaming ASR
# ============================================================

ASR_ENABLED=true

ASR_PROVIDER=nemo

ASR_MODEL=models/parakeet-unified-en-0.6b/parakeet-unified-en-0.6b.nemo
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16

ASR_LANGUAGE=en

ASR_INPUT_SAMPLE_RATE=8000
ASR_SAMPLE_RATE=16000

ASR_PRE_ROLL_MS=1200

ASR_PARTIAL_ENABLED=true
ASR_PARTIAL_MIN_AUDIO_MS=640
ASR_PARTIAL_INTERVAL_MS=480

ASR_FINAL_BEAM_SIZE=1
ASR_PARTIAL_BEAM_SIZE=1

ASR_MAX_UTTERANCE_SECONDS=30

ASR_QUEUE_MAXSIZE=16

ASR_WORKERS=1

ASR_LOG_PARTIALS=true

ASR_WORD_TIMESTAMPS=false

ASR_CONDITION_ON_PREVIOUS_TEXT=false

# TalkFlow owns VAD.
ASR_INTERNAL_VAD=false